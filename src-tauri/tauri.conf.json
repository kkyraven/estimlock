{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "estimlock",
  "version": "0.1.0",
  "identifier": "com.kinkyraven.estimlock",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "main.html",
        "create": false,
        "title": "estimlock",
        "width": 380,
        "height": 432,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "focus": false,
        "backgroundColor": "#17263f"
      },
      {
        "label": "widget",
        "url": "widget.html",
        "create": false,
        "title": "estimlock widget",
        "width": 248,
        "height": 88,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "kinkyraven",
    "copyright": "Copyright (c) 2026 kinkyraven",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../SAFETY.md": "SAFETY.md"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
